# Local development server. Use 0.0.0.0 to allow devices on your LAN.
APP_ENV=development
SEED_DEMO=true
COOKIE_SECURE=false
ENABLE_DOCS=true
# Use a random 32+ character token for first-owner setup on a public server.
SETUP_TOKEN=
# In production, set exact domains; never use *. See DEPLOY.md.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
# Set to the exact HTTPS public origin when the hosting proxy requires it.
PUBLIC_ORIGIN=
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Retail v3 uses SQLite. Legacy MySQL settings below are retained for reference.
DB_TYPE=sqlite
SQLITE_PATH=.local/taphoa360.db
SQLITE_JOURNAL_MODE=WAL

# Only the legacy database module uses these settings; Retail v3 does not.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=taphoa360_db
